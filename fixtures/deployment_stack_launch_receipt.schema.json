{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterburner.local/schemas/deployment-stack-launch-receipt/v1",
  "title": "Deployment Stack Launch Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_path",
    "profile_name",
    "deploy_hostname",
    "deployable_unit",
    "service_entrypoint",
    "launch_env",
    "launched_at_unix_ms"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "plan_path": { "type": "string", "minLength": 1 },
    "profile_name": { "type": "string", "minLength": 1 },
    "deploy_hostname": { "type": "string", "minLength": 1 },
    "deployable_unit": { "type": "string", "minLength": 1 },
    "service_entrypoint": { "type": "string", "minLength": 1 },
    "launch_env": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "required": ["PORT", "AFTERBURNER_OBS_JSONL_PATH"]
    },
    "launched_at_unix_ms": { "type": "integer", "minimum": 0 }
  }
}
