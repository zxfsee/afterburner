{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterburner.local/schemas/deployment-stack-launch-locator-reconciliation/v1",
  "title": "Deployment Stack Launch Locator Reconciliation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_path",
    "pointer_path",
    "desired",
    "current",
    "reconciliation_status"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "plan_path": { "type": "string", "minLength": 1 },
    "pointer_path": { "type": "string", "minLength": 1 },
    "desired": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_name", "deploy_hostname", "rollout_entrypoint"],
      "properties": {
        "profile_name": { "type": "string", "minLength": 1 },
        "deploy_hostname": { "type": "string", "minLength": 1 },
        "rollout_entrypoint": { "type": "string", "minLength": 1 }
      }
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator_path",
        "profile_name",
        "deploy_hostname",
        "rollout_entrypoint"
      ],
      "properties": {
        "locator_path": { "type": "string", "minLength": 1 },
        "profile_name": { "type": "string", "minLength": 1 },
        "deploy_hostname": { "type": "string", "minLength": 1 },
        "rollout_entrypoint": { "type": "string", "minLength": 1 }
      }
    },
    "reconciliation_status": {
      "type": "string",
      "enum": ["aligned", "needs-update"]
    }
  }
}
