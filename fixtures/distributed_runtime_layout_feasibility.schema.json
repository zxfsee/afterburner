{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterburner.local/schemas/distributed-runtime-layout-feasibility/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "node_count",
    "gpus_per_node",
    "world_size",
    "parallelism",
    "feasible",
    "checks"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "node_count": { "type": "integer", "minimum": 1 },
    "gpus_per_node": { "type": "integer", "minimum": 1 },
    "world_size": { "type": "integer", "minimum": 1 },
    "parallelism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dp",
        "tp",
        "pp",
        "sp_cp",
        "ep",
        "gas",
        "microbatch_size",
        "zero_stage"
      ],
      "properties": {
        "dp": { "type": "integer", "minimum": 1 },
        "tp": { "type": "integer", "minimum": 1 },
        "pp": { "type": "integer", "minimum": 1 },
        "sp_cp": { "type": "integer", "minimum": 1 },
        "ep": { "type": "integer", "minimum": 1 },
        "gas": { "type": "integer", "minimum": 1 },
        "microbatch_size": { "type": "integer", "minimum": 1 },
        "zero_stage": { "type": "integer", "enum": [0, 1, 2, 3] }
      }
    },
    "feasible": { "type": "boolean" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "passed"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
