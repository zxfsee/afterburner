{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterburner.local/schemas/deployment-stack-launch-evidence-handoff-history/v1",
  "title": "Deployment Stack Launch Evidence Handoff History",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event",
          "handoff_path",
          "bundle_path",
          "profile_name",
          "deploy_hostname",
          "deployable_unit",
          "rollout_entrypoint",
          "launched_at_unix_ms",
          "evidence_count",
          "recorded_at_unix_ms"
        ],
        "properties": {
          "event": { "type": "string", "minLength": 1 },
          "handoff_path": { "type": "string", "minLength": 1 },
          "bundle_path": { "type": "string", "minLength": 1 },
          "profile_name": { "type": "string", "minLength": 1 },
          "deploy_hostname": { "type": "string", "minLength": 1 },
          "deployable_unit": { "type": "string", "minLength": 1 },
          "rollout_entrypoint": { "type": "string", "minLength": 1 },
          "launched_at_unix_ms": { "type": "integer", "minimum": 0 },
          "evidence_count": { "type": "integer", "minimum": 0 },
          "recorded_at_unix_ms": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
