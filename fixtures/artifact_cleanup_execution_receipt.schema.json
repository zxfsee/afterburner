{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterburner.local/schemas/artifact-cleanup-execution-receipt/v1",
  "title": "Artifact Cleanup Execution Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dry_run_receipt_path",
    "policy_profile",
    "removed_paths",
    "skipped_paths",
    "executed_at_unix_ms"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "dry_run_receipt_path": { "type": "string", "minLength": 1 },
    "policy_profile": { "type": "string", "minLength": 1 },
    "removed_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "skipped_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "executed_at_unix_ms": { "type": "integer", "minimum": 0 }
  }
}
