{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterburner.local/schemas/profiling-provenance-receipt/v1",
  "title": "Profiling Provenance Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_path",
    "profile_kind",
    "profiler_version",
    "captured_at_unix_ms"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "snapshot_path": { "type": "string", "minLength": 1 },
    "refresh_receipt_path": { "type": "string", "minLength": 1 },
    "profile_kind": { "type": "string", "minLength": 1 },
    "profiler_version": { "type": "string", "minLength": 1 },
    "captured_at_unix_ms": { "type": "integer", "minimum": 0 }
  }
}
