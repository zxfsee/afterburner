{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterburner.local/schemas/infer-output-drift-baseline-history/v1",
  "title": "Infer Output Drift Baseline History v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": { "const": "1" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event",
          "pointer_path",
          "approval_path",
          "artifact",
          "artifact_version",
          "policy_profile",
          "recorded_at_unix_ms"
        ],
        "properties": {
          "event": { "type": "string", "minLength": 1 },
          "pointer_path": { "type": "string", "minLength": 1 },
          "approval_path": { "type": "string", "minLength": 1 },
          "artifact": { "type": "string", "minLength": 1 },
          "artifact_version": { "type": "string", "minLength": 1 },
          "policy_profile": { "type": "string", "minLength": 1 },
          "recorded_at_unix_ms": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
