{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterburner.local/schemas/profiling-provenance-evidence-bundle/v1",
  "title": "Profiling Provenance Evidence Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_path",
    "summary_path",
    "captured_at_unix_ms",
    "artifact_version",
    "profile_kind",
    "profiler",
    "backend",
    "evidence_count",
    "evidence_sources"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "snapshot_path": { "type": "string", "minLength": 1 },
    "summary_path": { "type": "string", "minLength": 1 },
    "refresh_receipt_path": { "type": "string", "minLength": 1 },
    "captured_at_unix_ms": { "type": "integer", "minimum": 0 },
    "artifact_version": { "type": "string", "minLength": 1 },
    "profile_kind": { "type": "string", "minLength": 1 },
    "profiler": { "type": "string", "minLength": 1 },
    "backend": { "type": "string", "minLength": 1 },
    "evidence_count": { "type": "integer", "minimum": 0 },
    "evidence_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_path",
          "artifact_role",
          "observed_at_unix_ms"
        ],
        "properties": {
          "artifact_path": { "type": "string", "minLength": 1 },
          "artifact_role": { "type": "string", "minLength": 1 },
          "observed_at_unix_ms": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
