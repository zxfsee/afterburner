{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterburner.local/schemas/pretraining-source-provenance-receipt/v1",
  "title": "Pretraining Source Provenance Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_receipt_path",
    "registry_entry_path",
    "upstream_locator",
    "reviewed_metadata_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "approval_receipt_path": { "type": "string", "minLength": 1 },
    "registry_entry_path": { "type": "string", "minLength": 1 },
    "upstream_locator": { "type": "string", "minLength": 1 },
    "reviewed_metadata_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
