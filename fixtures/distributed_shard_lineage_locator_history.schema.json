{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterburner.local/schemas/distributed-shard-lineage-locator-history/v1",
  "title": "Distributed Shard Lineage Locator History",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event",
          "pointer_path",
          "locator_path",
          "shard_id",
          "source",
          "source_revision",
          "checkpoint_group",
          "recorded_at_unix_ms"
        ],
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1
          },
          "pointer_path": {
            "type": "string",
            "minLength": 1
          },
          "locator_path": {
            "type": "string",
            "minLength": 1
          },
          "shard_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "source_revision": {
            "type": "string",
            "minLength": 1
          },
          "checkpoint_group": {
            "type": "string",
            "minLength": 1
          },
          "recorded_at_unix_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
