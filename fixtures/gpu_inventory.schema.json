{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterburner.local/schemas/gpu-inventory/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "node_id",
    "gpus"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "node_id": { "type": "string", "minLength": 1 },
    "gpus": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gpu_id",
          "state"
        ],
        "properties": {
          "gpu_id": { "type": "string", "minLength": 1 },
          "state": {
            "type": "string",
            "enum": ["free", "allocated"]
          }
        }
      }
    }
  }
}
