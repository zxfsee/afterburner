{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterburner.local/schemas/artifact-cleanup-policy/v1",
  "title": "Artifact Cleanup Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_name",
    "protected_categories",
    "prune_candidate_categories"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "profile_name": {
      "type": "string",
      "minLength": 1
    },
    "protected_categories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prune_candidate_categories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
