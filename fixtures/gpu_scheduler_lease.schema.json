{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterburner.local/schemas/gpu-scheduler-lease/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "lease_id",
    "node_id",
    "gpu_ids",
    "priority",
    "checkpoint_mode",
    "service_unit"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "job_id": { "type": "string", "minLength": 1 },
    "lease_id": { "type": "string", "minLength": 1 },
    "node_id": { "type": "string", "minLength": 1 },
    "gpu_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "priority": { "type": "integer", "minimum": 0 },
    "checkpoint_mode": {
      "type": "string",
      "enum": ["cooperative", "none"]
    },
    "service_unit": { "type": "string", "minLength": 1 }
  }
}
