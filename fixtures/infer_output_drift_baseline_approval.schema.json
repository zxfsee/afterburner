{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterburner.local/schemas/infer-output-drift-baseline-approval/v1",
  "title": "Infer Output Drift Baseline Approval v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline_path",
    "artifact",
    "artifact_version",
    "policy_profile",
    "approved_by",
    "approval_ticket",
    "approved_at_unix_ms"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "baseline_path": { "type": "string", "minLength": 1 },
    "artifact": { "type": "string", "minLength": 1 },
    "artifact_version": { "type": "string", "minLength": 1 },
    "policy_profile": { "type": "string", "minLength": 1 },
    "approved_by": { "type": "string", "minLength": 1 },
    "approval_ticket": { "type": "string", "minLength": 1 },
    "approved_at_unix_ms": { "type": "integer", "minimum": 0 }
  }
}
