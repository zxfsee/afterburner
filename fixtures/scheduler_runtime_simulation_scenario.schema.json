{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterburner.local/schemas/scheduler-runtime-simulation-scenario/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_name",
    "inventory",
    "lease",
    "layout",
    "lifecycle_messages",
    "checkpoint_restart",
    "artifact_plan"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "scenario_name": { "type": "string", "minLength": 1 },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_count", "gpus_per_node"],
      "properties": {
        "node_count": { "type": "integer", "minimum": 1 },
        "gpus_per_node": { "type": "integer", "minimum": 1 }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "lease_id", "node_ids", "gpu_ids", "checkpoint_mode"],
      "properties": {
        "job_id": { "type": "string", "minLength": 1 },
        "lease_id": { "type": "string", "minLength": 1 },
        "node_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "gpu_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "checkpoint_mode": { "type": "string", "minLength": 1 }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world_size", "parallelism"],
      "properties": {
        "world_size": { "type": "integer", "minimum": 1 },
        "parallelism": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dp", "tp", "pp", "sp_cp", "ep", "gas", "microbatch_size", "zero_stage"],
          "properties": {
            "dp": { "type": "integer", "minimum": 1 },
            "tp": { "type": "integer", "minimum": 1 },
            "pp": { "type": "integer", "minimum": 1 },
            "sp_cp": { "type": "integer", "minimum": 1 },
            "ep": { "type": "integer", "minimum": 1 },
            "gas": { "type": "integer", "minimum": 1 },
            "microbatch_size": { "type": "integer", "minimum": 1 },
            "zero_stage": { "type": "integer", "enum": [0, 1, 2, 3] }
          }
        }
      }
    },
    "lifecycle_messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["direction", "kind", "job_id", "lease_id"],
        "properties": {
          "direction": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "job_id": { "type": "string", "minLength": 1 },
          "lease_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "checkpoint_restart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_group", "restart_after_kind", "expected_resume_kind"],
      "properties": {
        "checkpoint_group": { "type": "string", "minLength": 1 },
        "restart_after_kind": { "type": "string", "minLength": 1 },
        "expected_resume_kind": { "type": "string", "minLength": 1 }
      }
    },
    "artifact_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "event", "path", "after_kind"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "event": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "after_kind": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
