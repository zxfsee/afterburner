{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterburner.local/schemas/distributed-shard-lineage-evidence-handoff/v1",
  "title": "Distributed Shard Lineage Evidence Handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_path",
    "shard_id",
    "source",
    "source_revision",
    "checkpoint_group",
    "evidence_count"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "bundle_path": { "type": "string", "minLength": 1 },
    "shard_id": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "source_revision": { "type": "string", "minLength": 1 },
    "checkpoint_group": { "type": "string", "minLength": 1 },
    "evidence_count": { "type": "integer", "minimum": 0 }
  }
}
