{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterburner.local/schemas/profiling-environment-snapshot/v1",
  "title": "Profiling Environment Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_kind",
    "profiler",
    "profiler_path",
    "profiler_version",
    "host_os",
    "host_arch"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "profile_kind": {
      "type": "string",
      "minLength": 1
    },
    "profiler": {
      "type": "string",
      "minLength": 1
    },
    "profiler_path": {
      "type": "string",
      "minLength": 1
    },
    "profiler_version": {
      "type": "string",
      "minLength": 1
    },
    "host_os": {
      "type": "string",
      "minLength": 1
    },
    "host_arch": {
      "type": "string",
      "minLength": 1
    }
  }
}
