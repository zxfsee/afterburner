{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterburner.local/schemas/deployment-verification-evidence-bundle-rollback/v1",
  "title": "Deployment Verification Evidence Bundle Rollback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "current_bundle_path",
    "restored_bundle_path",
    "previous_receipt_path",
    "restored_receipt_path",
    "previous_artifact_version",
    "restored_artifact_version",
    "profile_name",
    "previous_verification_status",
    "restored_verification_status",
    "previous_evidence_count",
    "restored_evidence_count",
    "rolled_back_at_unix_ms"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "current_bundle_path": { "type": "string", "minLength": 1 },
    "restored_bundle_path": { "type": "string", "minLength": 1 },
    "previous_receipt_path": { "type": "string", "minLength": 1 },
    "restored_receipt_path": { "type": "string", "minLength": 1 },
    "previous_artifact_version": { "type": "string", "minLength": 1 },
    "restored_artifact_version": { "type": "string", "minLength": 1 },
    "profile_name": { "type": "string", "minLength": 1 },
    "previous_verification_status": { "type": "string", "minLength": 1 },
    "restored_verification_status": { "type": "string", "minLength": 1 },
    "previous_evidence_count": { "type": "integer", "minimum": 0 },
    "restored_evidence_count": { "type": "integer", "minimum": 0 },
    "rolled_back_at_unix_ms": { "type": "integer", "minimum": 0 }
  }
}
