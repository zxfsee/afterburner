{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterburner.local/schemas/gpu-scheduler-heartbeat/v1",
  "title": "GPU Scheduler Heartbeat",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "lease_id",
    "worker_id",
    "state",
    "observed_at_unix_ms"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "job_id": { "type": "string", "minLength": 1 },
    "lease_id": { "type": "string", "minLength": 1 },
    "worker_id": { "type": "string", "minLength": 1 },
    "state": { "type": "string", "minLength": 1 },
    "observed_at_unix_ms": { "type": "integer", "minimum": 0 },
    "progress_marker": { "type": "string", "minLength": 1 }
  }
}
