{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterburner.local/schemas/huggingface-publish-receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repo_id",
    "revision",
    "request_path",
    "traceparent",
    "trace_id",
    "artifact_version",
    "uploaded_files",
    "published_at_unix_ms"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "repo_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "request_path": { "type": "string", "minLength": 1 },
    "traceparent": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "artifact_version": { "type": "string", "minLength": 1 },
    "uploaded_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["local_path", "path_in_repo"],
        "properties": {
          "local_path": { "type": "string", "minLength": 1 },
          "path_in_repo": { "type": "string", "minLength": 1 }
        }
      }
    },
    "published_at_unix_ms": { "type": "integer", "minimum": 0 }
  }
}
