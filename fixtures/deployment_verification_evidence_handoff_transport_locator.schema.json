{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterburner.local/schemas/deployment-verification-evidence-handoff-transport-locator/v1",
  "title": "Deployment Verification Evidence Handoff Transport Locator",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_path",
    "artifact_version",
    "profile_name",
    "verification_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "handoff_path": { "type": "string", "minLength": 1 },
    "artifact_version": { "type": "string", "minLength": 1 },
    "profile_name": { "type": "string", "minLength": 1 },
    "verification_status": { "type": "string", "minLength": 1 }
  }
}
