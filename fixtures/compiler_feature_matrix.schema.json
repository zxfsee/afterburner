{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterburner.local/schemas/compiler-feature-matrix/v1",
  "title": "Compiler Feature Matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "backend_feature_matrix"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "backend_feature_matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "backend",
          "enabled_features"
        ],
        "properties": {
          "backend": {
            "type": "string",
            "minLength": 1
          },
          "enabled_features": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
